policy_module(trestle, 0.2.0)

########################################
#
# Declarations
#
# trestled runs as trestled_t. The client binary keeps the standard bin_t
# label and runs in the domain of its caller (netavark/podman, containerd,
# CRI-O, kubelet, unconfined users); those domains are granted access to
# the trestled socket below.
#

type trestled_t;
type trestled_exec_t;
init_daemon_domain(trestled_t, trestled_exec_t)

# trestled.service sets NoNewPrivileges=yes, so systemd may only start the
# daemon in trestled_t with nnp_transition (Fedora's init_nnp_daemon_domain();
# written out because the reference policy has no such interface). Without
# it the daemon stays in init_t.
gen_require(`
	type init_t;
')
allow init_t trestled_t:process2 { nnp_transition nosuid_transition };

# /var/lib/trestle
type trestle_var_lib_t;
files_type(trestle_var_lib_t)

# /run/trestle (aardvark-dns configuration)
type trestle_var_run_t;
files_type(trestle_var_run_t)

# the socket: /var/lib/trestle/trestle.sock (default), or /tmp/trestle.sock
# (0.1 default, still possible)
type trestle_sock_t;
files_type(trestle_sock_t)
files_tmp_file(trestle_sock_t)

# hook scripts (/etc/trestle/hooks); they run in trestled_t
type trestle_script_exec_t;
files_type(trestle_script_exec_t)

########################################
#
# trestled local policy
#

allow trestled_t self:capability { net_admin sys_admin sys_ptrace dac_override dac_read_search chown fowner kill net_bind_service };
# The same capabilities used inside user namespaces (rootless Podman): the
# kernel checks them against the namespace owning the target, and SELinux
# then checks class cap_userns instead of capability. Needed to read the
# client's /proc/<pid>/exe (sys_ptrace), setns() into its network namespace
# (sys_admin), create and configure interfaces there (net_admin) and bind
# the DHCP client port there (net_bind_service).
allow trestled_t self:cap_userns { net_admin sys_admin sys_ptrace dac_override dac_read_search chown fowner kill net_bind_service };
allow trestled_t self:process { signal signull sigkill getsched setfscreate };
allow trestled_t self:fifo_file rw_fifo_file_perms;
allow trestled_t self:unix_stream_socket { create_stream_socket_perms listen accept connectto };
allow trestled_t self:unix_dgram_socket create_socket_perms;
allow trestled_t self:netlink_route_socket { create_netlink_socket_perms nlmsg_read nlmsg_write };
allow trestled_t self:udp_socket create_socket_perms;
allow trestled_t self:tcp_socket create_stream_socket_perms;

# state
manage_dirs_pattern(trestled_t, trestle_var_lib_t, trestle_var_lib_t)
manage_files_pattern(trestled_t, trestle_var_lib_t, trestle_var_lib_t)
files_var_lib_filetrans(trestled_t, trestle_var_lib_t, dir)

# runtime dir
gen_require(`
	type var_run_t;
	type tmp_t;
')
manage_dirs_pattern(trestled_t, trestle_var_run_t, trestle_var_run_t)
manage_files_pattern(trestled_t, trestle_var_run_t, trestle_var_run_t)
filetrans_pattern(trestled_t, var_run_t, trestle_var_run_t, dir, "trestle")
allow trestled_t var_run_t:dir rw_dir_perms;

# the socket; trestled removes whatever else sits at that path
manage_sock_files_pattern(trestled_t, trestle_var_lib_t, trestle_sock_t)
filetrans_pattern(trestled_t, trestle_var_lib_t, trestle_sock_t, sock_file)
manage_sock_files_pattern(trestled_t, tmp_t, trestle_sock_t)
files_tmp_filetrans(trestled_t, trestle_sock_t, sock_file)
allow trestled_t tmp_t:dir rw_dir_perms;
allow trestled_t tmp_t:{ file sock_file lnk_file } { getattr unlink };

# configuration (/etc/trestle is etc_t) and /etc/hosts
files_read_etc_files(trestled_t)
files_rw_etc_dirs(trestled_t)
sysnet_manage_config(trestled_t)
# temporary files created next to /etc/hosts get net_conf_t, so the
# atomic rename keeps the correct label
gen_require(`
	type etc_t, net_conf_t;
')
filetrans_pattern(trestled_t, etc_t, net_conf_t, file)

# identify clients: /proc/<pid>/exe, passwd/group lookups
domain_read_all_domains_state(trestled_t)
auth_use_nsswitch(trestled_t)

# network namespaces handed over by clients (setns)
fs_read_nsfs_files(trestled_t)
allow trestled_t domain:fd use;

# sysctl net.ipv4.ip_forward, network state
kernel_read_system_state(trestled_t)
kernel_read_network_state(trestled_t)
kernel_rw_net_sysctls(trestled_t)

# hook scripts and the tools they typically call (ip, tc, nsenter, logger)
can_exec(trestled_t, trestle_script_exec_t)
allow trestled_t trestle_script_exec_t:dir list_dir_perms;
corecmd_exec_shell(trestled_t)
corecmd_exec_bin(trestled_t)
allow trestled_t self:process { setpgid };

# aardvark-dns started in our domain when it is labeled bin_t
corenet_tcp_bind_generic_node(trestled_t)
corenet_udp_bind_generic_node(trestled_t)
corenet_tcp_bind_dns_port(trestled_t)
corenet_udp_bind_dns_port(trestled_t)

# ipam = dhcp: trestled runs itself as the per-container DHCP lease keeper
# (through systemd-run --scope, staying in trestled_t) and talks DHCP from
# UDP port 68 inside container network namespaces
can_exec(trestled_t, trestled_exec_t)
corenet_udp_bind_dhcpc_port(trestled_t)

logging_send_syslog_msg(trestled_t)
miscfiles_read_localization(trestled_t)

# nft
optional_policy(`
	iptables_domtrans(trestled_t)
	gen_require(`
		type iptables_t;
	')
	allow iptables_t trestled_t:fifo_file rw_inherited_fifo_file_perms;
	allow iptables_t trestled_t:fd use;
	# the unit runs with NoNewPrivileges=yes; allow the transition anyway
	allow trestled_t iptables_t:process2 { nnp_transition nosuid_transition };
	# normal side effects of the domain transition (secure-exec environment
	# cleanup, rlimit and signal reset); nft needs none of them disabled
	dontaudit trestled_t iptables_t:process { noatsecure rlimitinh siginh };
')

# systemd-run --scope for aardvark-dns and the DHCP lease keepers: D-Bus
# to systemd, and permission to start (and look at / stop) transient units.
# Fedora/RHEL check transient units against init_t (init_start_transient_unit()),
# the reference policy against systemd_transient_unit_t; written out so the
# module builds with both.
optional_policy(`
	dbus_system_bus_client(trestled_t)
	init_dbus_chat(trestled_t)
	gen_require(`
		type init_t;
		class service { start stop status };
	')
	allow trestled_t init_t:service { start stop status };
')
optional_policy(`
	gen_require(`
		type systemd_transient_unit_t;
		class service { start stop status };
	')
	allow trestled_t systemd_transient_unit_t:service { start stop status };
')

# NetworkManager: read connection profiles and run
# "nmcli device set <bridge> managed no" (D-Bus) for bridges trestle creates
# (raw rules on the types: the reading interfaces are named differently in
# the reference policy and in Fedora/RHEL, but the types are the same)
optional_policy(`
	networkmanager_dbus_chat(trestled_t)
	dbus_system_bus_client(trestled_t)
	gen_require(`
		type NetworkManager_etc_t, NetworkManager_etc_rw_t, NetworkManager_var_run_t;
	')
	list_dirs_pattern(trestled_t, NetworkManager_etc_t, NetworkManager_etc_t)
	read_files_pattern(trestled_t, NetworkManager_etc_t, NetworkManager_etc_t)
	list_dirs_pattern(trestled_t, NetworkManager_etc_t, NetworkManager_etc_rw_t)
	read_files_pattern(trestled_t, NetworkManager_etc_rw_t, NetworkManager_etc_rw_t)
	list_dirs_pattern(trestled_t, NetworkManager_var_run_t, NetworkManager_var_run_t)
	read_files_pattern(trestled_t, NetworkManager_var_run_t, NetworkManager_var_run_t)
')

# Profiles of other network managers, read before trestle creates a bridge
# (nm.c: is it a NetworkManager profile?) or deletes one (bridge.c: does
# systemd-networkd or libvirt define it?): keyfiles in /usr/lib (lib_t),
# ifcfg files (net_conf_t), /etc/systemd/network (etc_t, already readable),
# /usr/lib/systemd/network (lib_t), /run/systemd/network, libvirt networks.
gen_require(`
	type lib_t;
')
list_dirs_pattern(trestled_t, lib_t, lib_t)
read_files_pattern(trestled_t, lib_t, lib_t)
list_dirs_pattern(trestled_t, net_conf_t, net_conf_t)
read_files_pattern(trestled_t, net_conf_t, net_conf_t)
optional_policy(`
	gen_require(`
		type init_var_run_t;
	')
	list_dirs_pattern(trestled_t, init_var_run_t, init_var_run_t)
	read_files_pattern(trestled_t, init_var_run_t, init_var_run_t)
')
optional_policy(`
	gen_require(`
		type init_runtime_t;
	')
	list_dirs_pattern(trestled_t, init_runtime_t, init_runtime_t)
	read_files_pattern(trestled_t, init_runtime_t, init_runtime_t)
')
optional_policy(`
	gen_require(`
		type virt_etc_t, virt_etc_rw_t, virt_var_run_t;
	')
	list_dirs_pattern(trestled_t, virt_etc_t, virt_etc_rw_t)
	read_files_pattern(trestled_t, virt_etc_rw_t, virt_etc_rw_t)
	list_dirs_pattern(trestled_t, virt_var_run_t, virt_var_run_t)
	read_files_pattern(trestled_t, virt_var_run_t, virt_var_run_t)
')
optional_policy(`
	gen_require(`
		type virt_etc_t, virt_etc_rw_t, virt_runtime_t;
	')
	list_dirs_pattern(trestled_t, virt_etc_t, virt_etc_rw_t)
	read_files_pattern(trestled_t, virt_etc_rw_t, virt_etc_rw_t)
	list_dirs_pattern(trestled_t, virt_runtime_t, virt_runtime_t)
	read_files_pattern(trestled_t, virt_runtime_t, virt_runtime_t)
')

# "nmcli device set <bridge> managed no": NetworkManager identifies the
# D-Bus caller through its /proc entries (and may ask polkit about it)
optional_policy(`
	gen_require(`
		type NetworkManager_t;
	')
	allow NetworkManager_t trestled_t:dir search_dir_perms;
	allow NetworkManager_t trestled_t:file read_file_perms;
	allow NetworkManager_t trestled_t:lnk_file read_lnk_file_perms;
	allow NetworkManager_t trestled_t:process getattr;
')
optional_policy(`
	gen_require(`
		type policykit_t;
	')
	allow policykit_t trestled_t:dir search_dir_perms;
	allow policykit_t trestled_t:file read_file_perms;
	allow policykit_t trestled_t:lnk_file read_lnk_file_perms;
	allow policykit_t trestled_t:process getattr;
')

# firewalld: firewall-cmd (python, runs in trestled_t) moves bridges into
# the configured firewalld_zone over D-Bus
files_read_usr_files(trestled_t)
optional_policy(`
	firewalld_dbus_chat(trestled_t)
	dbus_system_bus_client(trestled_t)
')

# aardvark-dns labeled as a container runtime binary (Fedora / RHEL)
optional_policy(`
	gen_require(`
		type container_runtime_t, container_runtime_exec_t;
	')
	domtrans_pattern(trestled_t, container_runtime_exec_t, container_runtime_t)
	allow trestled_t container_runtime_t:process { signal signull sigkill };
	allow container_runtime_t trestle_var_run_t:dir manage_dir_perms;
	allow container_runtime_t trestle_var_run_t:file manage_file_perms;

	# netavark / podman run the trestle client
	files_search_var_lib(container_runtime_t)
	allow container_runtime_t trestle_var_lib_t:dir search_dir_perms;
	allow container_runtime_t trestle_sock_t:sock_file rw_sock_file_perms;
	allow container_runtime_t trestled_t:unix_stream_socket connectto;
	# (clients need no access to the /proc entries of trestled: the socket is in
	# a root-only directory, so the client does not check the server binary)
	allow trestled_t container_runtime_t:dir search;
	allow trestled_t container_runtime_t:file read_file_perms;
	allow trestled_t container_runtime_t:lnk_file read_lnk_file_perms;
')

# dnsmasq integration
optional_policy(`
	gen_require(`
		type dnsmasq_t, dnsmasq_etc_t, dnsmasq_var_run_t;
	')
	manage_files_pattern(trestled_t, dnsmasq_etc_t, dnsmasq_etc_t)
	read_files_pattern(trestled_t, dnsmasq_var_run_t, dnsmasq_var_run_t)
	allow trestled_t dnsmasq_t:process signal;
')

# unconfined users and services may use the plugin (e.g. podman run from a
# login shell, containerd/kubelet running unconfined)
optional_policy(`
	gen_require(`
		type unconfined_t, unconfined_service_t;
	')
	allow { unconfined_t unconfined_service_t } trestle_var_lib_t:dir search_dir_perms;
	allow { unconfined_t unconfined_service_t } trestle_sock_t:sock_file rw_sock_file_perms;
	allow { unconfined_t unconfined_service_t } trestled_t:unix_stream_socket connectto;
')
