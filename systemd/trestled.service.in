[Unit]
Description=trestle bridge attachment daemon for rootless containers
Documentation=man:trestled(8) man:trestle.conf(5)
After=network-pre.target systemd-tmpfiles-setup.service
Wants=network-pre.target
Before=network.target podman.service containerd.service crio.service kubelet.service

[Service]
Type=notify
NotifyAccess=main
ExecStartPre=@SBINDIR@/trestled --test
ExecStart=@SBINDIR@/trestled --foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

# The socket lives in /var/lib/trestle, so the daemon (and its hook
# scripts) can have a private /tmp. If you set "socket" to a path in /tmp,
# override this with PrivateTmp=no in a drop-in.
PrivateTmp=yes
# aardvark-dns is started through systemd-run in its own scope, so
# restarting trestled does not interrupt DNS for running containers.
KillMode=mixed

# NET_ADMIN: links/addresses/nftables  SYS_ADMIN: setns()  SYS_PTRACE: read
# /proc/<pid>/exe of other users' clients  KILL: signal aardvark/dnsmasq
# NET_BIND_SERVICE: aardvark-dns on port 53
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_KILL CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/etc
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
StateDirectory=trestle
# 0711: clients reach the socket by name, nobody else can list or read state
StateDirectoryMode=0711
RuntimeDirectory=trestle
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
