[Unit]
Description=trestle bridge attachment daemon for rootless containers
Documentation=man:trestled(8) man:trestle.conf(5)
After=network-pre.target systemd-tmpfiles-setup.service
Wants=network-pre.target
Before=network.target podman.service containerd.service crio.service kubelet.service

[Service]
Type=notify
NotifyAccess=main
ExecStartPre=/usr/sbin/trestled --test
ExecStart=/usr/sbin/trestled --foreground
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

# The daemon must see the real /tmp (its socket lives there for Netavark),
# the real network namespaces and /proc of its clients.
PrivateTmp=no
# aardvark-dns is started through systemd-run in its own scope, so
# restarting trestled does not interrupt DNS for running containers.
KillMode=mixed

# NET_ADMIN: links/addresses/nftables  SYS_ADMIN: setns()  SYS_PTRACE: read
# /proc/<pid>/exe of other users' clients  KILL: signal aardvark/dnsmasq
# NET_BIND_SERVICE: aardvark-dns on port 53
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_SYS_PTRACE CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_CHOWN CAP_FOWNER CAP_KILL CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=/etc
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
StateDirectory=trestle
StateDirectoryMode=0700
RuntimeDirectory=trestle
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
